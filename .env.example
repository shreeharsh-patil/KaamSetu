# ==============================================================================
# KaamSetu Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your local or cloud environment.
# Never commit actual production secrets to git.

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & SERVICE IDENTITY
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_VERSION=1.0.0
API_PREFIX=/api/v1
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Required for API and Worker)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas SRV or standalone MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Make sure 0.0.0.0/0 or Render outgoing IPs are whitelisted in MongoDB Atlas Network Access.
MONGODB_URI=mongodb://localhost:27017/kaamsetu

# ------------------------------------------------------------------------------
# 3. REDIS / RENDER KEY VALUE (Required for API and Worker)
# ------------------------------------------------------------------------------
# Redis connection URL for distributed caching, rate-limiting, and BullMQ queues.
# Supports standard 'redis://' and TLS-encrypted 'rediss://'.
# On Render, this is auto-populated from Render Key Value.
REDIS_URL=redis://localhost:6379

# Set REQUIRE_REDIS=true to enforce that API halts startup if Redis is unreachable.
# Default is 'false' which enables free-tier / demo resiliency (in-memory fallbacks).
REQUIRE_REDIS=false

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION & SECURITY (Required for API)
# ------------------------------------------------------------------------------
# Cryptographically strong secrets (minimum 32 characters each) used to sign JWTs.
# On Render Blueprint, these are automatically generated if omitted.
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long

# ------------------------------------------------------------------------------
# 5. CORS CONFIGURATION (Required for API)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed web frontend origins.
# Trailing slashes are automatically stripped by the server.
# Wildcard '*' is strictly rejected when NODE_ENV=production.
# Examples:
# Development: http://localhost:3000,http://localhost:5173
# Production: https://kaamsetu.vercel.app,https://www.kaamsetu.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Maximum HTTP request body size limit
BODY_SIZE_LIMIT=1mb

# ------------------------------------------------------------------------------
# 6. FILE STORAGE (AWS S3 or Local Mock)
# ------------------------------------------------------------------------------
# STORAGE_PROVIDER: 'mock' (in-memory/local for development/demo) or 's3' (production AWS)
STORAGE_PROVIDER=mock
S3_REGION=ap-south-1
S3_BUCKET=kaamsetu-uploads
# S3_ACCESS_KEY_ID=your_aws_access_key_id
# S3_SECRET_ACCESS_KEY=your_aws_secret_access_key
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
# CDN_BASE_URL=https://cdn.kaamsetu.com

# ------------------------------------------------------------------------------
# 7. WORKER PROBE CONFIGURATION (Worker process only)
# ------------------------------------------------------------------------------
# Port for worker container health check endpoint (GET /health, GET /ready)
WORKER_HEALTH_PORT=5001

# ------------------------------------------------------------------------------
# 8. OBSERVABILITY & ERROR TRACKING (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
METRICS_ENABLED=true

# ------------------------------------------------------------------------------
# 9. GEMINI AI & VOICE ENGINE (Optional)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BACKUP_MODEL=gemini-3.5-flash
