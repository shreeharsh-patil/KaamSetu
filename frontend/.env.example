# ==============================================================================
# KaamSetu Frontend Environment Variables (Phase 0 Baseline)
# ==============================================================================

# Backend REST API endpoint (Express server root)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Realtime WebSocket / Socket.IO server URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Map tile provider ('osm' | 'mapbox' | 'google')
NEXT_PUBLIC_MAP_PROVIDER=osm

# Sentry DSN for error telemetry (optional in development)
NEXT_PUBLIC_SENTRY_DSN=
